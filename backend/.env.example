PORT=4000
JWT_SECRET=change-this-to-something-random

# REQUIRED: real Postgres connection string. Get a free permanent one from
# Neon (neon.tech) — see README "Real hosted database (Postgres)" for steps.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: real email sending for verification codes.
# If left blank, verification codes just print to the server console
# instead (fine for testing). Gmail example below — you'd need an
# "App Password" from your Google Account (not your normal password),
# since Gmail blocks regular password login for apps like this.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cem SEO <your-email@gmail.com>"

# Optional: free API key for higher PageSpeed Insights quota.
# See README "Real SEO audit data" for how to get one.
GOOGLE_PAGESPEED_API_KEY=

# Optional: Google Search Console integration (real dashboard data).
# See README "Google Search Console setup" for how to get these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/gsc/callback
